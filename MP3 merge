import os
import numpy as np
import colorednoise as cn
import soundfile as sf
from pathlib import Path
import random

# -----------------------------
# Settings
# -----------------------------
BASE_DIR = Path(r"C:\Audio\Speach")
OUTPUT_DIR = Path(r"C:\Audio\Speach_augmented")
SPLITS = ['Training', 'Test', 'Validation']

# Noise definitions (β values)
NOISE_TYPES = {
    'WhiteNoise': 0.0,
    'PinkNoise': 1.0,
    'BrownNoise': 2.0,
    'BlueNoise': -1.0,
    'VioletNoise': -2.0
}

SNR_VALUES = [5, 10, 15]  # Fixed SNR per sample for balance

SEED = 42
np.random.seed(SEED)
random.seed(SEED)

# -----------------------------
# Utility functions
# -----------------------------
def mono(signal):
    if signal.ndim > 1:
        return signal.mean(axis=1)
    return signal

def add_colored_noise(signal, beta, snr_db):
    n = len(signal)
    noise = cn.powerlaw_psd_gaussian(beta, n).astype(np.float32)
    signal_power = np.mean(signal ** 2)
    noise_power = np.mean(noise ** 2)
    k = np.sqrt(signal_power / (noise_power * 10 ** (snr_db / 10)))
    noisy_signal = signal + noise * k
    return np.clip(noisy_signal, -1.0, 1.0)

# -----------------------------
# Create output directories
# -----------------------------
for split in SPLITS:
    for noise_name in list(NOISE_TYPES.keys()) + ['Clean']:
        os.makedirs(OUTPUT_DIR / split / noise_name, exist_ok=True)

# -----------------------------
# Process files
# -----------------------------
for split in SPLITS:
    split_dir = BASE_DIR / split
    for folder in split_dir.iterdir():
        if not folder.is_dir():
            continue

        files = sorted([f for f in folder.glob("*.wav")])

        for idx, file_path in enumerate(files, start=1):
            signal, samplerate = sf.read(file_path)
            signal = mono(signal).astype(np.float32)

            # -----------------------------
            # Clean copy
            # -----------------------------
            if folder.name.lower() in ['støjfri', 'clean']:
                out_file = OUTPUT_DIR / split / 'Clean' / f"Clean_{idx:03d}.wav"
                sf.write(out_file, signal, samplerate)
                continue

            # -----------------------------
            # Add noise per SNR
            # -----------------------------
            for snr_db in SNR_VALUES:
                for noise_name, beta in NOISE_TYPES.items():
                    noisy_signal = add_colored_noise(signal, beta, snr_db)
                    out_file = OUTPUT_DIR / split / noise_name / f"{noise_name}_SNR{snr_db}_{idx:03d}.wav"
                    sf.write(out_file, noisy_signal, samplerate)

print("Datasæt genereret med balance og reproducerbarhed.")